# ArgXConfig.cmake - the package file of ArgX for find_package(ArgX).
#
# Provides the target ArgX::argx. Link to it and nothing else is needed:
#
#   find_package(ArgX CONFIG REQUIRED)
#   target_link_libraries(<your-target> PRIVATE ArgX::argx)
#
# The same for a static and a shared ArgX.

@PACKAGE_INIT@

# ArgX_VERSION, set by find_package from ArgXConfigVersion.cmake, is the
# numeric part of the version, "<major>.<minor>.<patch>". The full version adds
# the pre-release identifiers, such as "0.2.0-rc.1"; for a release it equals
# ArgX_VERSION and ArgX_VERSION_PRERELEASE is empty.
set(ArgX_VERSION_FULL "@argx_version_full@")
set(ArgX_VERSION_PRERELEASE "@argx_version_prerelease@")

include("${CMAKE_CURRENT_LIST_DIR}/ArgXTargets.cmake")

# ArgX has no components: asking for one is an error.
check_required_components(ArgX)
