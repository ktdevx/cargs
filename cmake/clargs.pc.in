# clargs.pc - the pkg-config file of CLArgs.
#
#   cc main.c $(pkg-config --cflags --libs clargs)
#
# The same for a static and a shared CLArgs.

prefix=@clargs_pc_prefix@
libdir=@clargs_pc_libdir@
includedir=@clargs_pc_includedir@

Name: clargs
Description: A command-line argument parser library for C99
Version: @clargs_version_full@
Cflags: -I${includedir}@clargs_pc_cflags@
Libs: -L${libdir} -l@clargs_pc_library@
